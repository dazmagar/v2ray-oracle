# OCI provider
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaa..."
user_ocid        = "ocid1.user.oc1..aaaaaaaa..."
fingerprint      = "aa:bb:cc:dd:ee:ff:11:22:33:44:55:66:77:88:99:aa"
region           = "eu-frankfurt-1"
private_key_path = "path/to/oci/api/private/key.pem"

# Compartment
compartment_ocid = "ocid1.compartment.oc1..aaaaaaaa..."

# Compute
source_ocid           = "ocid1.image.oc1.eu-frankfurt-1.aaaaaaaa..." # e.g. Canonical Ubuntu 24.04
instance_display_name = "v2ray-server"
shape                 = "VM.Standard.E2.1.Micro"
instance_state        = "RUNNING"
instance_ad_number    = 3

# SSH (instance access; separate from OCI API private_key_path)
user           = "ubuntu"
publickeypath  = "path/to/ssh/public/key.pub"
privatekeypath = "path/to/ssh/private/key"

# Networking (NSG on VNIC; provide existing subnet OCID)
subnet_ocids = ["ocid1.subnet.oc1.eu-frankfurt-1.aaaaaaaa..."]
public_ip    = "RESERVED"

boot_volume_backup_policy = "disabled"

# V2Ray / 3x-ui
v2ray_host       = "v2ray.example.com"
panel_port       = 27419
panel_base_path  = "xui-a8f3b2c4/"
panel_host       = ""
enable_caddy_tls = true
caddy_use_internal_tls = true  # OCI-only: set false when port 80 is open for Let's Encrypt
proxy_port       = 8443

# NSG (proxy_port always merged; panel_port merged only when enable_caddy_tls = false)
firewall_tcp_ports = [
  22,
  80,
  443,
  37883,
]
firewall_udp_ports = [
  443,
]

xui_image = "ghcr.io/mhsanaei/3x-ui:v3.4.2"

cron_restart_schedule = "0 3 * * *"
backup_path           = "./modules/backup/xui_backup"
